{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ab-addon/weather",
  "version": "1.0.0",
  "title": "AB Weather",
  "category": "ab-addon",
  "icon": "cloud",
  "description": "Display live weather conditions and multi-day forecast for Ramdevra, Rajasthan.",
  "keywords": [
    "weather",
    "ramdevra",
    "forecast",
    "rajasthan",
    "temperature",
    "taxi"
  ],
  "attributes": {
    "mode": {
      "type": "string",
      "default": "full"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "forecastDays": {
      "type": "number",
      "default": 5
    },
    "showFeelsLike": {
      "type": "boolean",
      "default": true
    },
    "showHighLow": {
      "type": "boolean",
      "default": true
    },
    "showHumidity": {
      "type": "boolean",
      "default": true
    },
    "showWind": {
      "type": "boolean",
      "default": true
    },
    "showRainProb": {
      "type": "boolean",
      "default": true
    },
    "showSunTimes": {
      "type": "boolean",
      "default": true
    },
    "showUpdatedTime": {
      "type": "boolean",
      "default": true
    },
    "showCta": {
      "type": "boolean",
      "default": true
    },
    "ctaText": {
      "type": "string",
      "default": ""
    },
    "ctaUrl": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "customClassName": true,
    "align": ["wide", "full"]
  },
  "editorScript": "ab-weather-block-editor",
  "editorStyle": "ab-weather-block-editor-style"
}
